{
  "name": "diligence-mcp-healthcheck",
  "nodes": [
    {
      "id": "h1",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "h0",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        160
      ],
      "parameters": {}
    },
    {
      "id": "h2",
      "name": "list_documents",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "endpointUrl": "http://127.0.0.1:8765/mcp",
        "serverTransport": "httpStreamable",
        "authentication": "bearerAuth",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "list_documents"
        },
        "inputMode": "json",
        "jsonInput": "{}",
        "options": {
          "convertToBinary": false
        }
      },
      "credentials": {
        "httpBearerAuth": {
          "id": "dlgMcpBearer01",
          "name": "Diligence MCP (docs:read)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "h4",
      "name": "Alert",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        480,
        80
      ],
      "parameters": {
        "errorMessage": "={{ 'Diligence MCP unreachable or unauthorized: ' + ($json.error?.message || 'unknown') }}"
      }
    },
    {
      "id": "h5",
      "name": "Got documents?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ($json.structuredContent?.result || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "h3",
      "name": "Healthy",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        720,
        -160
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Every 15 min": {
      "main": [
        [
          {
            "node": "list_documents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "list_documents": {
      "main": [
        [
          {
            "node": "Got documents?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "list_documents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Got documents?": {
      "main": [
        [
          {
            "node": "Healthy",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false
}